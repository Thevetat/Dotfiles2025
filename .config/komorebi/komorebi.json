{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_boundary_behaviour": "Monitor",
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": false,
  "default_workspace_padding": 6,
  "default_container_padding": 3,
  "resize_delta": 100,
  "border": true,
  "border_width": 4,
  "border_offset": -1,
  "border_style": "System",
  "border_colours": {
    "single": "#44a1e3",
    "stack": "#9dd274",
    "monocle": "#44a1e3",
    "unfocused": "#494d64"
  },
  "animation": {
    "enabled": true,
    "duration": 125,
    "fps": 240,
    "style": "EaseOutSine"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
        {
          "name": "6",
          "layout": "BSP"
        },
        {
          "name": "7",
          "layout": "BSP"
        },
        {
          "name": "8",
          "layout": "BSP"
        }
      ]
    }
  ]
}
