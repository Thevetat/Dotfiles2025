.shell powershell

# Lifecycle and shortcut help
alt + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
alt + shift + o         : komorebic reload-configuration
alt + i                 : komorebic toggle-shortcuts

# Window navigation
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right

# Window movement
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right

# Window state
ctrl + shift + f        : komorebic toggle-float
alt + shift + f         : komorebic toggle-monocle
alt + f                 : komorebic promote

# Workspaces
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4

# Move windows across workspaces and follow focus
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + p         : komorebic cycle-move-to-workspace previous
alt + shift + n         : komorebic cycle-move-to-workspace next

# Workspace mirroring
alt + shift + s         : powershell -NoProfile -ExecutionPolicy Bypass -File "$Env:KOMOREBI_CONFIG_HOME\toggle-stack-layout.ps1"
alt + shift + x         : komorebic flip-layout horizontal
alt + shift + y         : komorebic flip-layout vertical

# Directional resize
ctrl + alt + h          : komorebic resize-edge left increase
ctrl + alt + j          : komorebic resize-edge down increase
ctrl + alt + k          : komorebic resize-edge up increase
ctrl + alt + l          : komorebic resize-edge right increase
ctrl + alt + e          : komorebic retile
ctrl + alt + g          : powershell -NoProfile -ExecutionPolicy Bypass -File "$Env:KOMOREBI_CONFIG_HOME\toggle-gaps.ps1"

# Borders
ctrl + alt + b          : komorebic border disable
ctrl + alt + shift + b  : komorebic border enable

# Set the insertion point for the next window
ctrl + alt + shift + h  : komorebic preselect-direction left
ctrl + alt + shift + j  : komorebic preselect-direction down
ctrl + alt + shift + k  : komorebic preselect-direction up
ctrl + alt + shift + l  : komorebic preselect-direction right
ctrl + alt + shift + s  : komorebic toggle-workspace-window-container-behaviour

# Insert a new window in the current application
alt + s                 : komorebic preselect-direction right; Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.SendKeys]::SendWait('^n')
alt + v                 : komorebic preselect-direction down; Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.SendKeys]::SendWait('^n')

# Miscellaneous
alt + t                 : Start-Process wezterm.exe
alt + shift + t         : komorebic retile
alt + shift + r         : komorebic reload-configuration
