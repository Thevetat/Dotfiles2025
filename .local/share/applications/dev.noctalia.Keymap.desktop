[Desktop Entry]
Type=Application
Name=Keymap
Comment=Browse and search Hyprland keybindings
Exec=/usr/bin/bash -lc "sleep 0.2; exec ~/.local/bin/noctalia-keymap"
Icon=input-keyboard
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Keywords=keymap;keybindings;keyboard;shortcuts;hyprland;
