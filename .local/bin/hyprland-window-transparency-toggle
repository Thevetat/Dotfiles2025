#!/usr/bin/env bash

set -euo pipefail

address=$(hyprctl activewindow -j | jq -r '.address // empty')
[[ -n $address ]] || exit 0

window="address:$address"
hyprctl dispatch "hl.dsp.window.set_prop({ window = \"$window\", prop = \"opaque\", value = \"toggle\" })" >/dev/null 2>&1 || \
  hyprctl dispatch setprop "$window" opaque toggle >/dev/null
