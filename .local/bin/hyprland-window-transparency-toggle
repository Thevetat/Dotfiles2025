#!/usr/bin/env bash

set -euo pipefail

address=$(hyprctl activewindow -j | jq -r '.address // empty')
[[ -n $address ]] || exit 0

window="address:$address"
opacity=$(hyprctl getprop "$window" opacity)
if [[ $opacity == 1 || $opacity == 1.0 ]]; then
  value="0.8 override"
else
  value="1.0 override"
fi

hyprctl dispatch "hl.dsp.window.set_prop({ window = \"$window\", prop = \"opacity\", value = \"$value\" })" >/dev/null 2>&1 || \
  hyprctl dispatch setprop "$window" opacity "$value" >/dev/null
