#!/bin/sh

set -eu

main_session=main

if ! tmux has-session -t "=$main_session" 2>/dev/null; then
    exec tmux new-session -s "$main_session"
fi

view_session="$main_session-view-$$"

tmux new-session -d -s "$view_session" -t "=$main_session"
tmux new-window -t "=$view_session:"
exec tmux attach-session -t "=$view_session" \; \
    set-option -t "=$view_session" destroy-unattached keep-last
