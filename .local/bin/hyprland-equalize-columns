#!/usr/bin/env bash

set -euo pipefail

workspace_id=$(hyprctl activeworkspace -j | jq -r '.id')
focused_address=$(hyprctl activewindow -j | jq -r '.address')

restore_focus() {
  hyprctl --quiet dispatch "hl.dsp.focus({ window = \"address:$focused_address\" })" || true
}
trap restore_focus EXIT

mapfile -t columns < <(
  hyprctl clients -j | jq -r --argjson workspace_id "$workspace_id" '
    def column_bands:
      group_by([.at[0], (.at[0] + .size[0])])
      | map({
          x: .[0].at[0],
          right: (.[0].at[0] + .[0].size[0]),
          address: .[0].address
        })
      | sort_by(.x);

    [
      .[]
      | select(.workspace.id == $workspace_id and .mapped and (.floating | not))
    ] as $clients
    | ($clients | column_bands) as $columns
    | if ($columns | length) >= 2
        and all(range(1; $columns | length); $columns[.].x >= $columns[. - 1].right)
      then $columns
      else
        $clients
        | group_by([.at[1], (.at[1] + .size[1])])
        | map(column_bands | select(length >= 2))
        | sort_by(length)
        | last // []
      end
    | .[]
    | [.x, .right, .address]
    | @tsv
  '
)

((${#columns[@]} >= 2)) || exit 0

declare -a xs rights addresses
for column in "${columns[@]}"; do
  IFS=$'\t' read -r x right address <<<"$column"
  xs+=("$x")
  rights+=("$right")
  addresses+=("$address")
done

column_count=${#columns[@]}
left=${xs[0]}
right=${rights[0]}
gap_total=0
gap_count=0

for ((i = 1; i < column_count; i++)); do
  ((rights[i] > right)) && right=${rights[i]}
  candidate_gap=$((xs[i] - rights[i - 1]))
  ((candidate_gap >= 0)) || exit 0
  gap_total=$((gap_total + candidate_gap))
  gap_count=$((gap_count + 1))
done

gap=$((gap_count > 0 ? (gap_total + gap_count / 2) / gap_count : 0))
available_width=$((right - left - gap * (column_count - 1)))

# Move each divider by resizing the column on its left. Hyprland clamps the
# inverse operation when a right-hand window's left neighbor is near minimum.
for ((i = 1; i < column_count; i++)); do
  desired_left=$((left + (i * available_width + column_count / 2) / column_count + i * gap))
  desired_right=$((desired_left - gap))
  current_right=$(
    hyprctl clients -j | jq -r --arg address "${addresses[i - 1]}" '
      .[] | select(.address == $address) | (.at[0] + .size[0])
    '
  )
  delta=$((desired_right - current_right))

  if ((delta != 0)); then
    hyprctl --quiet dispatch "hl.dsp.focus({ window = \"address:${addresses[i - 1]}\" })"
    hyprctl --quiet dispatch "hl.dsp.window.resize({ x = $delta, y = 0, relative = true })"
  fi
done

restore_focus
trap - EXIT
