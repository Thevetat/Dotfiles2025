#!/usr/bin/env bash

set -euo pipefail

[[ $# -gt 0 ]] || {
  printf 'Usage: hyprland-scratch-terminal TERMINAL [ARG ...]\n' >&2
  exit 1
}

initial_title="CachyOS Scratch Terminal"
workspace="special:scratch"

client_address() {
  hyprctl clients -j | jq -r --arg title "$initial_title" \
    '[.[] | select(.initialTitle == $title)] | last | .address // empty'
}

toggle_scratch() {
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratch")' >/dev/null 2>&1 || \
    hyprctl dispatch togglespecialworkspace scratch >/dev/null
}

address=$(client_address)
if [[ -n $address ]]; then
  toggle_scratch
  exit 0
fi

printf -v command '%q ' \
  "$@" \
  "--title=$initial_title" \
  --title-report=false \
  -e tmux new-session -A -s scratch

hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || \
  hyprctl dispatch exec -- bash -lc "$command" >/dev/null

for _ in {1..50}; do
  address=$(client_address)
  [[ -n $address ]] && break
  sleep 0.1
done

[[ -n $address ]] || {
  printf 'Scratch terminal did not open.\n' >&2
  exit 1
}

client_workspace=$(hyprctl clients -j | jq -r --arg address "$address" \
  '.[] | select(.address == $address) | .workspace.name')
if [[ $client_workspace != "$workspace" ]]; then
  window="address:$address"
  hyprctl dispatch "hl.dsp.window.move({ window = \"$window\", workspace = \"$workspace\", follow = false })" >/dev/null 2>&1 || \
    hyprctl dispatch movetoworkspacesilent "$workspace,$window" >/dev/null
fi

toggle_scratch
